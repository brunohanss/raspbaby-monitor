{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer/windows-hooks.nsh"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Raspbaby Monitor",
        "width": 1440,
        "height": 850,
        "minWidth": 360,
        "minHeight": 640,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ]
  }
}
