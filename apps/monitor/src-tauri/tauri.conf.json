{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raspbaby Monitor",
  "version": "0.1.0",
  "identifier": "org.raspbaby.monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Raspbaby Monitor", "width": 1440, "height": 850, "minWidth": 360, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "targets": "all" }
}
